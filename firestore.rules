rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function participantIds() {
      return resource.data.participant_ids;
    }

    function requestParticipantIds() {
      return request.resource.data.participant_ids;
    }

    function isParticipant(ids) {
      return isSignedIn() && ids.hasAny([request.auth.uid]);
    }

    match /chats/{chatId} {
      allow read: if isParticipant(participantIds());

      allow create: if isSignedIn()
        && requestParticipantIds().size() == 2
        && isParticipant(requestParticipantIds())
        && request.resource.data.keys().hasOnly(['participant_ids', 'updated_at', 'last_message']);

      allow update: if isParticipant(participantIds())
        && request.resource.data.participant_ids == resource.data.participant_ids
        && request.resource.data.keys().hasOnly(['participant_ids', 'updated_at', 'last_message']);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participant_ids);

        allow create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participant_ids)
          && request.resource.data.keys().hasOnly(['text', 'sender_id', 'created_at'])
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }
  }
}
